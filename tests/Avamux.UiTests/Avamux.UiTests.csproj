<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests that drive real Avalonia controls (the wiki editor and its pictures) in Avalonia's headless platform,
       drawn with Skia so text is measured and wrapped as on screen. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <ProjectReference Include="..\..\src\Avamux\Avamux.csproj" />
    <Using Include="Xunit" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
