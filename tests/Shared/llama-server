#!/usr/bin/env python3
"""A stand-in for llama.cpp's llama-server, for AI Workloads tests.

Takes --port, --alias, --ctx-size and --model like the real one, and answers /health (503 while "loading"),
/props, /slots and /v1/models. Environment:
  FAKE_LLAMA_LOAD_SECONDS  how long it pretends to load (default 1)
  FAKE_LLAMA_FAIL          print this line and exit 1 after loading starts (e.g. "CUDA error: out of memory")
  FAKE_LLAMA_BUSY          a file: while it exists, /slots says a request is being worked on
  FAKE_LLAMA_COMMIT        the commit --version reports (default abc1234)
"""
import json, os, signal, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

args = sys.argv[1:]
if "--version" in args:
    print(f"version: 1 (build 1, commit {os.environ.get('FAKE_LLAMA_COMMIT', 'abc1234')})")
    sys.exit(0)
def arg(*names, default=None):
    for i, a in enumerate(args):
        for n in names:
            if a == n and i + 1 < len(args):
                return args[i + 1]
            if a.startswith(n + "="):
                return a[len(n) + 1:]
    return default

port = int(arg("--port", default="8080"))
alias = arg("--alias", "-a", default="fake")
ctx = int(arg("--ctx-size", "-c", default="4096"))
model = arg("--model", "-m", default="fake.gguf")
load = float(os.environ.get("FAKE_LLAMA_LOAD_SECONDS", "1"))
started = time.time()
tasks = 0

print(f"main: fake llama-server, model {model}, alias {alias}, ctx {ctx}, port {port}", flush=True)
fail = os.environ.get("FAKE_LLAMA_FAIL")
if fail:
    time.sleep(0.3)
    print(fail, flush=True)
    sys.exit(1)

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        global tasks
        loading = time.time() - started < load
        if self.path == "/health":
            return self.send(503, {"error": {"code": 503, "message": "Loading model", "type": "unavailable_error"}}) if loading else self.send(200, {"status": "ok"})
        if loading:
            return self.send(503, {"error": {"message": "Loading model"}})
        if self.path == "/props":
            return self.send(200, {"model_alias": alias, "model_path": model, "total_slots": 1, "default_generation_settings": {"n_ctx": ctx}})
        if self.path == "/slots":
            busy = bool(os.environ.get("FAKE_LLAMA_BUSY")) and os.path.exists(os.environ["FAKE_LLAMA_BUSY"])
            if busy:
                tasks += 1
            return self.send(200, [{"id": 0, "id_task": tasks, "is_processing": busy, "next_token": [{"n_decoded": 42 if busy else 0}]}])
        if self.path == "/v1/models":
            return self.send(200, {"object": "list", "data": [{"id": alias}]})
        self.send(404, {"error": "not found"})

signal.signal(signal.SIGTERM, lambda *a: (print("received SIGTERM, shutting down", flush=True), os._exit(0)))
ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
