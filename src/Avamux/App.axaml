<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Avamux.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Browser toolbar buttons: a disabled one (no page to go back to) fades rather than turning into a grey box. -->
    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource Tk.dim}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Tk.panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Tk.line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Tk.link}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Tk.linkHi}" />
    </Style>
    <Style Selector="ListBox.lines ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.lines">
      <Setter Property="Background" Value="{DynamicResource Tk.bgEditor}" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- Full-pane editors: keep their own background and no focus ring. -->
    <Style Selector="TextBox.pane /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Tk.bgEditor}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ListBox.nav.mini ListBoxItem">
      <Setter Property="Margin" Value="4,1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Title bar buttons of windows that draw their own chrome. -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Tk.titleFg}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.chrome PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Tk.titleFg}" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.tab.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Tk.accent}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tab.on /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Tk.accent}" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.rows">
      <Setter Property="Background" Value="{DynamicResource Tk.bgEditor}" />
    </Style>
    <!-- A splitter between side-by-side panes: a hairline that thickens in the accent colour under the pointer and
         while dragged, over a wider transparent strip that is easier to catch, with a resize cursor. -->
    <Style Selector="GridSplitter.divider">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="7" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Border Name="PART_Line" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Tk.line}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.divider:pointerover /template/ Border#PART_Line">
      <Setter Property="Width" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Tk.accent}" />
    </Style>
    <Style Selector="GridSplitter.divider:pressed /template/ Border#PART_Line">
      <Setter Property="Width" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Tk.accent}" />
    </Style>
  </Application.Styles>
</Application>
