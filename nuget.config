<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins package restore to nuget.org so a user- or machine-level NuGet.Config (corporate feeds, private mirrors,
  source mappings) cannot redirect or break a build of this repository.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
