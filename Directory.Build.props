<Project>
  <!--
    Machine-only overrides (not committed): put a Directory.Build.local.props next to this file, for example
      <Project><PropertyGroup><AvamuxEasterEggs>true</AvamuxEasterEggs></PropertyGroup></Project>
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Hidden extras in EasterEggs folders. Off unless a local override (or -p:AvamuxEasterEggs=true) turns them on. -->
    <AvamuxEasterEggs Condition="'$(AvamuxEasterEggs)' == ''">false</AvamuxEasterEggs>
  </PropertyGroup>
</Project>
