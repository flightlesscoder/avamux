<Project Sdk="Microsoft.NET.Sdk">
  <!-- A page plugin: a page of your own in avamux's navigation, built by this DLL.
       Build it (dotnet build), then in avamux: Settings → Custom pages → Add a page → kind "Plugin", and choose
       bin/Debug/net10.0/SamplePagePlugin.dll (`avamux page add /?` shows how to do the same from the command line).
       After a rebuild, press the page's reload button in Settings (or `avamux page reload Sample`); no restart needed. -->
  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Both are provided by avamux at run time, so neither is copied next to the plugin. Use the Avalonia
         version avamux itself is built with. -->
    <PackageReference Include="Avalonia" Version="12.1.2" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\Avamux.Plugin.Abstractions\Avamux.Plugin.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
